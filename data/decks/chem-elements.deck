title: Element Symbols
subject: Chemistry
level: KS3/GCSE
emoji: 🔤
description: Match common elements to their chemical symbols.
---
Symbol for sodium? :: Na (from natrium)
Symbol for potassium? :: K (from kalium)
Symbol for iron? :: Fe (from ferrum)
Symbol for copper? :: Cu (from cuprum)
Symbol for silver? :: Ag (from argentum)
Symbol for gold? :: Au (from aurum)
Symbol for lead? :: Pb (from plumbum)
Symbol for mercury? :: Hg (from hydrargyrum)
Symbol for tin? :: Sn (from stannum)
Symbol for tungsten? :: W (from wolfram)
Symbol for helium? :: He
Symbol for neon? :: Ne
Symbol for magnesium? :: Mg
Symbol for calcium? :: Ca
Symbol for zinc? :: Zn
Symbol for chlorine? :: Cl
Symbol for sulfur? :: S
Symbol for phosphorus? :: P
Symbol for nitrogen? :: N
Symbol for lithium? :: Li
Symbol for aluminium? :: Al
Symbol for silicon? :: Si
Symbol for boron? :: B
Symbol for beryllium? :: Be
