{
  "name": "d1-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create my-d1-database",
    "db:init": "wrangler d1 execute my-d1-database --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute my-d1-database --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
